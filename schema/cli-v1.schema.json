{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam machine result envelope 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "ok",
        "result"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "ok",
        "error"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retry",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "retry": {
              "enum": [
                "never",
                "same_request",
                "after_reconcile"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
