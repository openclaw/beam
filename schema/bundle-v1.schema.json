{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam portable bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packetDigest",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packetDigest": {
      "$ref": "#/$defs/digest"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "mediaType",
          "bytes",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Display filename, at most 255 UTF-8 bytes; no separators, control or formatting characters.",
            "pattern": "^[^/\\\\\\p{Cc}\\p{Cf}]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "path": {
            "type": "string",
            "pattern": "^assets/(0[1-9]|1[0-6])\\.(png|jpg|gif|webp|pdf|txt|wav|mp3|mp4|webm)$"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/gif",
              "image/webp",
              "application/pdf",
              "text/plain",
              "audio/wav",
              "audio/mpeg",
              "video/mp4",
              "video/webm"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
