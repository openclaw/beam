{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam packet v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "beamId",
    "source",
    "title",
    "updatedAt",
    "completed",
    "items"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "beamId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 160,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "completed": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9._-]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "\\s"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "enum": [
              "userMessage",
              "agentMessage",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "speaker": {
            "type": "string",
            "pattern": "^p([1-9]|[1-9][0-9]|1[0-9]{2}|200)$"
          }
        },
        "dependentSchemas": {
          "speaker": {
            "properties": {
              "type": {
                "const": "userMessage"
              }
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "status",
        "tokensUsed"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S",
          "x-length-unit": "unicode-scalars"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "blocked",
            "usageLimited",
            "budgetLimited",
            "complete"
          ]
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tokensUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
