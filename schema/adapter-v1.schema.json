{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam adapter protocol 1",
  "description": "One request to a locally configured executable. Responses use cli-v1.schema.json. Validate successful result values against the matching operation in adapter-result-v1.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "capabilities"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "limit"
          ],
          "properties": {
            "op": {
              "const": "list"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "limit",
            "selection"
          ],
          "properties": {
            "op": {
              "const": "read"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "selection": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "operationId",
            "packet"
          ],
          "properties": {
            "op": {
              "const": "openCopy"
            },
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "packet": {
              "oneOf": [
                {
                  "$ref": "packet-v2.schema.json"
                },
                {
                  "$ref": "packet-v3.schema.json"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "operationId",
            "packet"
          ],
          "properties": {
            "op": {
              "const": "stageReference"
            },
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "packet": {
              "oneOf": [
                {
                  "$ref": "packet-v2.schema.json"
                },
                {
                  "$ref": "packet-v3.schema.json"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "operationId"
          ],
          "properties": {
            "op": {
              "const": "lookupOperation"
            },
            "operationId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "handle"
          ],
          "properties": {
            "op": {
              "const": "resolve"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "handle",
            "requestId",
            "instruction"
          ],
          "properties": {
            "op": {
              "const": "send"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "instruction": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
