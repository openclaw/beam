{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beam v1 OpenClaw upload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "beamId",
    "source",
    "title",
    "updatedAt",
    "completed",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "beamId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 160,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "completed": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "\\s"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "enum": [
              "userMessage",
              "agentMessage",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 6000,
            "pattern": "\\S"
          }
        }
      }
    },
    "hookEvent": {
      "type": "string",
      "maxLength": 64,
      "pattern": "\\S"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
